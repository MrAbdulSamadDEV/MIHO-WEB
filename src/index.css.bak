@import "tailwindcss";

:root {
  --bg: #050505;
  --panel: #0b0b0b;
  --line: #262626;
  --silver: #c9c9c9;
  --muted: #a0a0a0;
  --font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 0 !important;
}

/* ==========================================================================
   STRICT ZERO BORDER-RADIUS POLICY
   All UI containers, cards, buttons, badges, popups, inputs have 0 border-radius.
   ========================================================================== */
button,
a,
input,
textarea,
select,
dialog,
.btn,
.cta,
.card,
.window,
.tile,
.preview,
.tag,
[class*="rounded"] {
  border-radius: 0 !important;
}

/* Exception: organic artwork ring */
.ring {
  border-radius: 50% !important;
}

/* ==========================================================================
   DEDICATED MODAL STYLES (Zero Border-Radius, High Spacing, Full Responsiveness)
   ========================================================================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background-color: rgba(0, 0, 0, 0.90);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  overflow-x: hidden;
  overflow-y: auto;
  box-sizing: border-box;
}

.modal-window {
  position: relative;
  width: 100%;
  max-width: 820px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  background-color: #0c0c0c;
  border: 1px solid #282828;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.95);
  border-radius: 0 !important;
  color: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
  min-width: 0;
}

.modal-doc-window {
  max-width: 900px !important;
}

.modal-header {
  padding: 24px 28px 18px;
  border-bottom: 1px solid #222222;
  flex-shrink: 0;
  box-sizing: border-box;
  min-width: 0;
}

.modal-body {
  padding: 24px 28px 28px;
  overflow-y: auto;
  overflow-x: hidden;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  scrollbar-width: thin;
  scrollbar-color: #2a2a2a #0a0a0a;
}

.modal-body::-webkit-scrollbar {
  width: 6px;
}
.modal-body::-webkit-scrollbar-track {
  background: #0a0a0a;
}
.modal-body::-webkit-scrollbar-thumb {
  background: #2a2a2a;
}
.modal-body::-webkit-scrollbar-thumb:hover {
  background: #444444;
}

.modal-footer {
  padding: 16px 28px;
  background-color: #070707;
  border-top: 1px solid #202020;
  flex-shrink: 0;
  box-sizing: border-box;
  min-width: 0;
}

.modal-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  min-width: 0;
}

@media (max-width: 640px) {
  .modal-overlay {
    padding: 8px !important;
  }
  .modal-window {
    width: 100% !important;
    max-width: calc(100vw - 16px) !important;
    max-height: 94vh !important;
  }
  .modal-header {
    padding: 16px 14px 12px !important;
  }
  .modal-body {
    padding: 14px 14px 20px !important;
    gap: 18px !important;
  }
  .modal-footer {
    padding: 12px 14px !important;
  }
  .modal-grid-2 {
    grid-template-columns: 1fr !important;
    gap: 12px !important;
  }
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
  background-color: var(--bg);
  color: #ffffff;
  font-family: var(--font-body);
  overflow-x: hidden;
  max-width: 100vw;
}

body {
  background-color: var(--bg);
  color: #ffffff;
  font: 16px var(--font-body), Arial, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
  max-width: 100vw;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

/* Consistent central wrapper matching HTML preview */
.wrap {
  width: min(1200px, calc(100% - 44px));
  margin: auto;
}

.brand, h1, h2, h3 {
  font-family: var(--font-heading);
  letter-spacing: -0.05em;
}

.brand {
  font-size: 25px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.eyebrow {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--silver);
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

/* Header & Nav */
.top {
  height: 76px;
  position: fixed;
  z-index: 50;
  inset: 0 0 auto;
  background: #050505c9;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid #242424;
}

.nav {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.links {
  display: flex;
  gap: 27px;
  font-size: 12px;
  color: #bbb;
}

.links a {
  transition: color 0.2s ease;
}

.links a:hover {
  color: #fff;
}

.cta {
  padding: 11px 17px;
  background: #eee;
  color: #080808;
  font-size: 10px;
  letter-spacing: 0.1em;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.cta:hover {
  background: #fff;
  color: #000;
}

/* Buttons */
.btn {
  padding: 13px 18px;
  border: 1px solid #777;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  color: #fff;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn:hover {
  border-color: #fff;
  color: #fff;
}

.btn.primary {
  background: #eee;
  color: #050505;
  border-color: #eee;
}

.btn.primary:hover {
  background: #fff;
  border-color: #fff;
  color: #000;
}

/* Hero Section */
.hero {
  min-height: 780px;
  padding: 140px 0 80px;
  display: grid;
  align-items: center;
  background: radial-gradient(ellipse at 75% 44%, #292929, #111 25%, #050505 62%);
  overflow: hidden;
}

.heroGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 20px;
}

.hero h1 {
  font-size: clamp(54px, 7.5vw, 100px);
  line-height: 0.92;
  font-weight: 500;
  margin: 20px 0;
  letter-spacing: -0.05em;
}

.hero h1 span {
  color: #aaa;
}

.hero p {
  max-width: 480px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.6;
}

.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.sculpture {
  height: 500px;
  display: grid;
  place-items: center;
  position: relative;
}

.metal {
  width: min(100%, 560px);
  filter: drop-shadow(0 35px 40px #000);
  animation: floatAnim 8s ease-in-out infinite;
}

.ring {
  position: absolute;
  width: 75%;
  height: 60%;
  border: 1px solid #aaa5;
  border-radius: 50%;
  transform: rotate(-25deg);
  pointer-events: none;
}

@keyframes floatAnim {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-16px) rotate(2deg);
  }
}

/* Sections */
.section {
  padding: 115px 0;
  border-top: 1px solid #ffffff10;
}

.intro {
  max-width: 700px;
  margin-bottom: 48px;
}

.intro h2 {
  font-size: clamp(38px, 5.2vw, 68px);
  line-height: 1.02;
  font-weight: 500;
  margin: 15px 0;
}

.intro p, .copy p {
  color: var(--muted);
  font-size: 17px;
  max-width: 620px;
  line-height: 1.6;
}

/* Grid & Cards */
.grid3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.card {
  padding: 28px;
  min-height: 220px;
  border: 1px solid var(--line);
  background: linear-gradient(145deg, #151515, #090909);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.card:hover {
  border-color: #444;
}

.card small {
  color: #777;
  font: 10px monospace;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.card h3 {
  font-size: 27px;
  font-weight: 500;
  margin: 35px 0 5px;
}

.card p {
  font-size: 13px;
  color: #999;
  line-height: 1.6;
}

/* Split Columns */
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 45px;
  align-items: center;
}

/* Window UI */
.window {
  background: #090909;
  border: 1px solid #333;
  padding: 17px;
  min-height: 330px;
}

.bar {
  border-bottom: 1px solid #282828;
  padding-bottom: 12px;
  color: #777;
  font: 10px monospace;
}

.desk {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 15px;
  padding-top: 20px;
}

.side {
  border-right: 1px solid #292929;
}

.line {
  height: 7px;
  background: #333;
  margin: 16px 10px 16px 0;
}

.line.active {
  background: #aaa;
  width: 65%;
}

.pane {
  padding: 8px;
}

.pane strong {
  font: 22px var(--font-heading);
}

.tile {
  background: #151515;
  border: 1px solid #292929;
  padding: 15px;
  margin-top: 15px;
  color: #aaa;
  font-size: 11px;
}

/* Wavebox Audio Visualizer */
.wavebox {
  height: 330px;
  border: 1px solid #333;
  background: radial-gradient(ellipse, #242424, #090909);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0 20px;
}

.wavebox i {
  width: 3px;
  background: linear-gradient(#fff, #555);
  animation: pulseAnim 1.4s ease-in-out infinite alternate;
}

@keyframes pulseAnim {
  to {
    transform: scaleY(0.35);
    opacity: 0.5;
  }
}

/* Code & Preview */
.code {
  background: #090909;
  border: 1px solid #333;
  padding: 25px;
  color: #aaa;
  font: 12px/2 monospace;
}

.code b {
  color: #fff;
}

.preview {
  background: linear-gradient(140deg, #1b1b1b, #080808);
  border: 1px solid #333;
  padding: 35px;
  min-height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.preview strong {
  font: 38px/1.1 var(--font-heading);
}

/* Tags Grid */
.tags {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.tag {
  padding: 25px;
  border: 1px solid #292929;
  background: #0c0c0c;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: border-color 0.2s ease;
  cursor: pointer;
}

.tag:hover {
  border-color: #555;
}

.tag b {
  display: block;
  margin-top: 20px;
  font-weight: 500;
  font-family: var(--font-heading);
  font-size: 18px;
}

/* Showcase */
.showcase {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 14px;
}

/* Final CTA */
.ctaSection {
  text-align: center;
  padding: 120px 0;
  background: radial-gradient(ellipse at center bottom, #292929, #050505 65%);
}

.ctaSection h2 {
  font-size: clamp(44px, 6.8vw, 82px);
  line-height: 1.02;
  font-weight: 500;
  margin: 15px 0 25px;
}

/* Footer */
.footer {
  border-top: 1px solid #292929;
  padding: 50px 0 35px;
  color: #888;
  font-size: 12px;
}

.foot {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.footlinks {
  display: flex;
  gap: 24px;
}

.footlinks a:hover {
  color: #fff;
}

/* Responsive Media Queries */
@media (max-width: 800px) {
  .hero {
    min-height: auto;
    padding: 100px 0 40px;
  }
  .heroGrid, .split, .showcase {
    grid-template-columns: 1fr;
  }
  .heroGrid {
    gap: 24px;
  }
  .sculpture {
    height: 260px;
    margin-top: 10px;
  }
  .grid3 {
    grid-template-columns: 1fr 1fr;
  }
  .tags {
    grid-template-columns: 1fr 1fr;
  }
  .links {
    gap: 16px;
  }
  .section {
    padding: 85px 0;
  }
}

@media (max-width: 560px) {
  .links {
    display: none;
  }
  .hero {
    padding-top: 120px;
  }
  .hero h1 {
    font-size: clamp(34px, 10.5vw, 48px);
    word-break: break-word;
  }
  .grid3, .tags {
    grid-template-columns: 1fr;
  }
  .section {
    padding: 70px 0;
  }
  .sculpture {
    height: 290px;
  }
  .foot {
    flex-direction: column;
  }
  .wrap {
    width: calc(100% - 32px);
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
